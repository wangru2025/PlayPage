[Unit]
Description=AI Static Host Web
After=network.target

[Service]
Type=simple
User=ai-static-host
Group=ai-static-host
WorkingDirectory=/opt/ai-static-host/web/.next/standalone
Environment=PORT=13000
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_PUBLIC_API_BASE_URL=
Environment=INTERNAL_API_BASE_URL=http://127.0.0.1:18080
ExecStart=/usr/bin/node /opt/ai-static-host/web/.next/standalone/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=append:/var/log/ai-static-host/web.log
StandardError=append:/var/log/ai-static-host/web.error.log

[Install]
WantedBy=multi-user.target
